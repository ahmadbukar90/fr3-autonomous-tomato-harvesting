<?xml version="1.0"?>
<package format="3">
  <name>fr3_tomato_harvesting</name>
  <version>0.1.0</version>
  <description>
    Autonomous tomato harvesting with a Franka FR3, ROS 2, RGB-D perception,
    simulation, and tactile sensing.
  </description>

  <maintainer email="ahmadbukar90@gmail.com">Ahmad Abubakar</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>tomato_interfaces</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>franka_fr3_moveit_config</exec_depend>
  <exec_depend>franka_description</exec_depend>
  <exec_depend>mujoco_fr3_bringup</exec_depend>
</package>
