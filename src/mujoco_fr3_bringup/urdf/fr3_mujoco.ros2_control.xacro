<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
    name="fr3_mujoco_ros2_control"
    params="
      headless:=false
      camera_publish_rate:=10.0">

    <ros2_control name="MujocoSystem" type="system">

      <hardware>
        <plugin>mujoco_fr3_bringup/FR3TomatoMujocoSystem</plugin>

        <param name="mujoco_model">
          $(find mujoco_fr3_bringup)/simulation/franka_fr3/harvesting_scene.xml
        </param>

        <param name="sim_speed_factor">1.0</param>
        <param name="initial_keyframe">home</param>
        <param name="headless">${headless}</param>

        <param name="camera_publish_rate">
          ${camera_publish_rate}
        </param>
      </hardware>

      <!-- Torque-controlled FR3 arm -->

      <joint name="fr3_joint1">
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="torque"/>
      </joint>

      <joint name="fr3_joint2">
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="torque"/>
      </joint>

      <joint name="fr3_joint3">
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="torque"/>
      </joint>

      <joint name="fr3_joint4">
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">-1.57079</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="torque"/>
      </joint>

      <joint name="fr3_joint5">
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="torque"/>
      </joint>

      <joint name="fr3_joint6">
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">1.57079</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="torque"/>
      </joint>

      <joint name="fr3_joint7">
        <command_interface name="effort"/>

        <state_interface name="position">
          <param name="initial_value">-0.7853</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="torque"/>
      </joint>

      <!-- Position-controlled gripper -->

      <joint name="fr3_finger_joint1">
        <command_interface name="position"/>

        <state_interface name="position">
          <param name="initial_value">0.06</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="force"/>
      </joint>

      <joint name="fr3_finger_joint2">
        <command_interface name="position"/>

        <state_interface name="position">
          <param name="initial_value">0.06</param>
        </state_interface>

        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="force"/>
      </joint>

      <!-- The sensor name must match the MJCF camera name exactly. -->

      <!-- ====================================================== -->
      <!-- D405 COLOR LENS                                        -->
      <!--                                                        -->
      <!-- Use RGB from this camera. Its depth stream is sent     -->
      <!-- to an unused topic.                                    -->
      <!-- ====================================================== -->

      <sensor name="d405_color">
        <param name="frame_name">d405_color_optical_frame</param>
        <param name="info_topic">/camera/color/camera_info</param>
        <param name="image_topic">/camera/color/image_raw</param>
        <param name="depth_topic">/camera/color/depth_unused</param>
      </sensor>

      <!-- ====================================================== -->
      <!-- D405 OPPOSITE / DEPTH LENS                             -->
      <!--                                                        -->
      <!-- Use DEPTH from this camera. Its RGB stream is sent      -->
      <!-- to an unused topic.                                    -->
      <!-- ====================================================== -->

      <sensor name="d405_depth">
        <param name="frame_name">d405_depth_optical_frame</param>
        <param name="info_topic">/camera/depth/camera_info</param>
        <param name="image_topic">/camera/depth/color_unused</param>
        <param name="depth_topic">/camera/depth/image_raw</param>
      </sensor>

      <!-- ====================================================== -->
      <!-- D405 DEPTH CAMERA                                      -->
      <!-- Opposite physical lens in the MJCF model.              -->
      <!-- ====================================================== -->


    </ros2_control>

  </xacro:macro>

</robot>
